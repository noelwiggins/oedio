/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00060/full/pct:50/0/default.jpg"}, {"page": 61, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00061/full/pct:50/0/default.jpg"}, {"page": 62, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00062/full/pct:50/0/default.jpg"}, {"page": 63, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00063/full/pct:50/0/default.jpg"}, {"page": 64, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00064/full/pct:50/0/default.jpg"}, {"page": 65, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00065/full/pct:50/0/default.jpg"}, {"page": 66, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00066/full/pct:50/0/default.jpg"}, {"page": 67, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00067/full/pct:50/0/default.jpg"}, {"page": 68, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00068/full/pct:50/0/default.jpg"}, {"page": 69, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00069/full/pct:50/0/default.jpg"}, {"page": 70, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00070/full/pct:50/0/default.jpg"}, {"page": 71, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00071/full/pct:50/0/default.jpg"}, {"page": 72, "text": "", "image": "https://tile.loc.gov/image-services/iiif/service:gdc:gdcwdl:wd:l_:07:11:6:wdl_07116:00072/full/pct:50/0/default.jpg"}, {"page": 73, "text": "", "image": "https://tile.loc.gov/image-services/ii